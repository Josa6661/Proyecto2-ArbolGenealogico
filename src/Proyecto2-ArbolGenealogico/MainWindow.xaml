<Window x:Class="Proyecto2_ArbolGenealogico.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto2_ArbolGenealogico"
        mc:Ignorable="d"
        Title="Árbol Genealógico"
        Width="900" Height="600"
        Background="#0E1A2B"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Definimos columnas: lateral izquierdo y área de árbol -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel lateral -->
        <Border Grid.Column="0" Background="#13243C" Padding="20" CornerRadius="5">
            <StackPanel VerticalAlignment="Top" Margin="0,10">
                <TextBlock Text="Agregar Familiar"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#64B5F6"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Nombre" Foreground="White"/>
                <TextBox x:Name="txtNombre" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White"/>

                <TextBlock Text="Apellido" Foreground="White"/>
                <TextBox x:Name="txtApellido" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White"/>

                <TextBlock Text="Ciudad de Residencia" Foreground="White"/>
                <TextBox x:Name="txtCiudad" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White"/>

                <TextBlock Text="País de Residencia" Foreground="White"/>
                <TextBox x:Name="txtPais" Margin="0,5,0,20" Background="#1E2F4C" Foreground="White"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar"
                            Width="90"
                            Margin="0,0,10,0"
                            Background="#25364F"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Content="Agregar"
                            Width="90"
                            Background="#2196F3"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Agregar_Click"/>

                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Área del árbol genealógico -->
        <Grid Grid.Column="1" Background="#0B1524">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Margin="10">
                <Canvas x:Name="ArbolCanvas">
                    <!-- Aquí se generarán los nodos dinámicamente -->
                </Canvas>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
