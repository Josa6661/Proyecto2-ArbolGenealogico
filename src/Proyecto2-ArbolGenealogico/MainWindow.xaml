<Window x:Class="Proyecto2_ArbolGenealogico.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto2_ArbolGenealogico"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        mc:Ignorable="d"
        Title="Árbol Genealógico"
        Width="900" Height="600"
        Background="#0E1A2B"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Definimos columnas: lateral izquierdo y área de árbol -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel lateral con scroll -->
        <Border Grid.Column="0" Background="#13243C" CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel VerticalAlignment="Top" Margin="0,10">
                    <TextBlock Text="Agregar Familiar"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#64B5F6"
                               Margin="0,0,0,15"/>

                    <!-- Nombre Completo -->
                    <TextBlock Text="Nombre Completo *" Foreground="White" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtNombre" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White"/>

                    <!-- Cédula -->
                    <TextBlock Text="Cédula *" Foreground="White" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtCedula" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White"/>

                    <!-- Fecha de Nacimiento -->
                    <TextBlock Text="Fecha de Nacimiento (dd/MM/yyyy) *" Foreground="White" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtFechaNacimiento" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White" 
                             ToolTip="Ejemplo: 15/03/1990"/>

                    <!-- Edad -->
                    <TextBlock Text="Edad *" Foreground="White" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtEdad" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White"/>

                    <!-- Fotografía -->
                    <TextBlock Text="Fotografía" Foreground="White" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                        <TextBox x:Name="txtFotoRuta" Width="150" Background="#1E2F4C" Foreground="White" 
                                 IsReadOnly="True" ToolTip="Ruta de la imagen"/>
                        <Button Content="Explorar..." Width="80" Margin="5,0,0,0" 
                                Background="#25364F" Foreground="White" 
                                BorderThickness="0" Cursor="Hand"
                                Click="ExplorarFoto_Click"/>
                    </StackPanel>

                    <!-- Coordenadas -->
                    <TextBlock Text="Coordenadas de Residencia *" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,5"/>

                    <TextBlock Text="Latitud" Foreground="#B0BEC5" FontSize="11"/>
                    <TextBox x:Name="txtLatitud" Margin="0,2,0,8" Background="#1E2F4C" Foreground="White"
                             ToolTip="Ejemplo: 9.9281"/>

                    <TextBlock Text="Longitud" Foreground="#B0BEC5" FontSize="11"/>
                    <TextBox x:Name="txtLongitud" Margin="0,2,0,10" Background="#1E2F4C" Foreground="White"
                             ToolTip="Ejemplo: -84.0907"/>

                    <!-- Padre (opcional) -->
                    <TextBlock Text="Seleccionar Padre (opcional)" Foreground="White" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbPadre" 
                              Background="#1E2F4C" 
                              Foreground="Blue" 
                              Margin="0,5,0,5"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              SelectionChanged="CmbPadre_SelectionChanged"
                              ToolTip="Selecciona o escribe el nombre del padre. Dejar vacío si es la raíz del árbol"/>

                    <CheckBox x:Name="chkEsPadreDeRaiz"
                              Content="Este será padre de la raíz actual"
                              Foreground="#FFD54F"
                              Margin="0,5,0,10"
                              FontWeight="SemiBold"
                              Checked="ChkEsPadreDeRaiz_Checked"
                              Unchecked="ChkEsPadreDeRaiz_Unchecked"
                              ToolTip="Marca esta opción si quieres agregar un ancestro al nodo raíz actual"/>

                    <!-- Cónyuge (opcional) -->
                    <TextBlock Text="Seleccionar Cónyuge (opcional)" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <ComboBox x:Name="cmbConyuge" 
                              Background="#1E2F4C" 
                              Foreground="#81C784" 
                              Margin="0,5,0,15"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              SelectionChanged="CmbConyuge_SelectionChanged"
                              ToolTip="Selecciona el miembro al que quieres agregar como cónyuge"/>

                    <!-- Eliminar Miembro -->
                    <TextBlock Text="Eliminar Miembro" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <ComboBox x:Name="cmbEliminar" 
                              Background="#1E2F4C" 
                              Foreground="#FF5252" 
                              Margin="0,5,0,5"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              ToolTip="Selecciona el miembro que deseas eliminar"/>
                    <Button Content="Eliminar Seleccionado"
                            Background="#D32F2F"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,0,15"
                            Click="Eliminar_Click"/>

                    <!-- Botones -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Limpiar"
                                Width="90"
                                Margin="0,0,10,0"
                                Background="#25364F"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Limpiar_Click"/>
                        <Button Content="Agregar"
                                Width="90"
                                Background="#2196F3"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Agregar_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Área del árbol genealógico y mapa -->
        <Grid Grid.Column="1" Background="#0B1524">
            <TabControl x:Name="MainTabControl" 
                        Background="#0B1524"
                        BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#13243C"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="15,8"/>
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderThickness="0"
                                            CornerRadius="5,5,0,0">
                                        <Border Padding="{TemplateBinding Padding}">
                                            <ContentPresenter 
                                                    ContentSource="Header"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                        </Border>

                                       
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#64B5F6"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E2F4C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 1: Árbol Genealógico -->
                <TabItem Header="Árbol Genealógico">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="10">
                        <Canvas x:Name="ArbolCanvas">
                            <!-- Aquí se generarán los nodos dinámicamente -->
                        </Canvas>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Mapa Mundial -->
                <TabItem Header="Mapa de Residencias">
                    <Grid Background="#0B1524">
                        <mapsui:MapControl x:Name="MapaResidencias"
                                          Margin="10"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>
                        <!-- Canvas overlay para fotos de familiares -->
                        <Canvas x:Name="CanvasOverlayMapa"
                               Margin="10"
                               IsHitTestVisible="True"
                               Background="{x:Null}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"/>
                    </Grid>
                </TabItem>
                <!-- Tab 3: Estadísticas -->
                <TabItem Header="Estadísticas">
                    <Grid Background="#0B1524">
                        <StackPanel Margin="20">
                            <TextBlock Text="Estadísticas de Distancias"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

                            <!-- Texto: par más lejos -->
                            <TextBlock x:Name="txtLejos"
                       FontSize="16"
                       Foreground="#64B5F6"
                       Margin="0,10"/>

                            <!-- Texto: par más cerca -->
                            <TextBlock x:Name="txtCerca"
                       FontSize="16"
                       Foreground="#81C784"
                       Margin="0,10"/>

                            <!-- Texto: distancia promedio -->
                            <TextBlock x:Name="txtPromedio"
                       FontSize="16"
                       Foreground="#FFD54F"
                       Margin="0,10"/>

                            <!-- Botón para actualizar -->
                            <Button Content="Actualizar Estadísticas"
                    Width="220"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    Background="#2196F3"
                    Foreground="White"
                    Click="ActualizarEstadisticas_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
