<Window x:Class="Proyecto2_ArbolGenealogico.Views.EditarNodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Familiar"
        Width="400" Height="500"
        Background="#0E1A2B"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Border Background="#13243C" CornerRadius="5" Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <TextBlock Text="Editar Familiar"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#64B5F6"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Nombre Completo *" Foreground="White" FontWeight="SemiBold"/>
                <TextBox x:Name="txtNombre" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White"/>

                <TextBlock Text="Cédula *" Foreground="White" FontWeight="SemiBold"/>
                <TextBox x:Name="txtCedula" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White" IsReadOnly="True"/>

                <TextBlock Text="Fecha de Nacimiento (dd/MM/yyyy) *" Foreground="White" FontWeight="SemiBold"/>
                <TextBox x:Name="txtFechaNacimiento" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White"/>

                <TextBlock Text="Edad *" Foreground="White" FontWeight="SemiBold"/>
                <TextBox x:Name="txtEdad" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White"/>

                <TextBlock Text="Fotografía" Foreground="White" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                    <TextBox x:Name="txtFotoRuta" Width="220" Background="#1E2F4C" Foreground="White" IsReadOnly="True"/>
                    <Button Content="Explorar..." Width="80" Margin="5,0,0,0" 
                            Background="#25364F" Foreground="White" 
                            BorderThickness="0" Cursor="Hand"
                            Click="ExplorarFoto_Click"/>
                </StackPanel>

                <TextBlock Text="Latitud *" Foreground="White" FontWeight="SemiBold"/>
                <TextBox x:Name="txtLatitud" Margin="0,5,0,10" Background="#1E2F4C" Foreground="White"/>

                <TextBlock Text="Longitud *" Foreground="White" FontWeight="SemiBold"/>
                <TextBox x:Name="txtLongitud" Margin="0,5,0,15" Background="#1E2F4C" Foreground="White"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Guardar" Width="100" Height="35" Margin="5"
                            Background="#4CAF50" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            Click="Guardar_Click"/>
                    <Button Content="Cancelar" Width="100" Height="35" Margin="5"
                            Background="#F44336" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            Click="Cancelar_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
